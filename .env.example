# Production: PostgreSQL via a JDBC URL. Never put real secrets in this example.
PORT=8080
PUBLIC_URL=https://www.crystalpowers.co.uk
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_POOLER_HOST:5432/postgres?sslmode=verify-full
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Exactly one owner; remove OWNER_SETUP_TOKEN after MFA enrolment.
# Generate both values independently with a cryptographically secure generator.
OWNER_SETUP_TOKEN=
# Base64-encoded 32 random bytes. Keep a separate private backup: required to decrypt MFA.
APP_ENCRYPTION_KEY=

# Private Supabase bucket. No anonymous read or write policies.
MEDIA_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=project-media

# HTTPS delivery works on Render free. The sender domain must be verified with Resend.
MAIL_PROVIDER=resend
RESEND_API_KEY=
APP_MAIL_TO=
APP_MAIL_FROM=

# Optional SMTP compatibility for hosts that permit SMTP. Use MAIL_PROVIDER=smtp explicitly.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Local-only development: --spring.profiles.active=local
# Uses a gitignored H2 database, private local media, secure random local MFA encryption key,
# HTTP session cookie and disabled outgoing email. It does not read .env automatically.
