# Production: PostgreSQL via a JDBC URL. Never put real secrets in this example.
PORT=8080
PUBLIC_URL=https://crystal-powers.com
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_POOLER_HOST:5432/postgres?sslmode=verify-full
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Exactly one owner; remove OWNER_SETUP_TOKEN after MFA enrolment.
# Generate both values independently with a cryptographically secure generator.
OWNER_SETUP_TOKEN=
# Base64-encoded 32 random bytes. Keep a separate private backup: required to decrypt MFA.
APP_ENCRYPTION_KEY=

# Private Supabase bucket. No anonymous read or write policies.
MEDIA_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=project-media

# HTTPS delivery works on Render free. The sender domain must be verified with Resend.
MAIL_PROVIDER=resend
RESEND_API_KEY=
APP_MAIL_TO=
APP_MAIL_FROM=
APP_MAIL_REPLY_TO=
# Set only after the corresponding mailboxes can receive mail; blank destinations use APP_MAIL_TO.
APP_MAIL_SUPPORT_TO=
APP_MAIL_SALES_TO=
APP_MAIL_GENERAL_TO=
# Omit these overrides to inherit APP_MAIL_REPLY_TO. A blank override means no Reply-To header.
# APP_MAIL_SUPPORT_REPLY_TO=
# APP_MAIL_ADMIN_REPLY_TO=

# Stripe billing is disabled by default. Start with a sandbox/test account.
# Never place Stripe secret keys in VITE_* variables or browser code.
# Match the webhook endpoint API version to 2026-09-30.endive.
BILLING_ENABLED=false
STRIPE_LIVE_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional bounded recovery of pending signed events, after sandbox acceptance.
BILLING_EVENT_RECOVERY_ENABLED=false

# Optional SMTP compatibility for hosts that permit SMTP. Use MAIL_PROVIDER=smtp explicitly.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Local-only development: --spring.profiles.active=local
# Uses a gitignored H2 database, private local media, secure random local MFA encryption key,
# HTTP session cookie and disabled outgoing email. It does not read .env automatically.

# Trusted private clamd endpoint. Keep disabled until configured and accepted.
UPLOAD_SCAN_ENABLED=false
UPLOAD_SCAN_HOST=
UPLOAD_SCAN_PORT=3310
# Optional read-only reconciliation worker; enable only after provider/database acceptance.
BILLING_INVOICE_RECOVERY_ENABLED=false

# Keep disabled until authorised refund sandbox acceptance is complete.
BILLING_REFUNDS_ENABLED=false

# Private channel attachment storage: 512 MiB default per workspace.
TEAM_UPLOAD_MAX_WORKSPACE_BYTES=536870912

# Enable only after company delivery and HTTPS PUBLIC_URL are verified.
INVITATION_EMAIL_ENABLED=false

# Public privacy page stays unavailable until approved complete copy is configured.
PRIVACY_PUBLISHED=false
PRIVACY_CONTENT_JSON=
